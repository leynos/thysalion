# The swamp fragment's named graph. See keep-interior.trig for why this is a
# placeholder rather than a modelling decision.

@prefix thy: <https://thysalion.df12.net/ontology#> .
@prefix scene: <https://thysalion.df12.net/scene/> .

scene:swamp-fragment {
    scene:swamp-fragment a thy:Scene ;
        thy:sceneClass thy:WildernessClass .
}
